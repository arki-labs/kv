{
  "name": "@arki/kv",
  "version": "0.5.0",
  "description": "Key-value store abstraction with pluggable adapters for ARKI — Redis-backed Keyv client and rate-limiter with TLS auto-detection and Upstash support.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/arki-labs/arki.git"
  },
  "homepage": "https://arki.dev",
  "bugs": {
    "url": "https://github.com/arki-labs/arki/issues"
  },
  "keywords": [
    "arki",
    "typescript",
    "kv",
    "key-value",
    "redis",
    "keyv",
    "rate-limit",
    "cache"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./env": {
      "types": "./dist/env.d.ts",
      "import": "./dist/env.js",
      "default": "./dist/env.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js",
      "default": "./dist/errors.js"
    },
    "./instance": {
      "types": "./dist/instance.d.ts",
      "import": "./dist/instance.js",
      "default": "./dist/instance.js"
    },
    "./redis/idempotency": {
      "types": "./dist/redis/idempotency.d.ts",
      "import": "./dist/redis/idempotency.js",
      "default": "./dist/redis/idempotency.js"
    },
    "./dot": {
      "types": "./dist/dot.d.ts",
      "import": "./dist/dot.js",
      "default": "./dist/dot.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**",
    "src/**",
    "!src/**/*.test.*",
    "!src/**/*.spec.*",
    "!src/**/tests/**",
    "!src/**/test/**",
    "!src/**/__tests__/**",
    "README.md",
    "docs/**",
    "llms.txt",
    "LICENSE",
    "package.json"
  ],
  "dependencies": {
    "@arki/contracts": "0.4.1",
    "@arki/env": "0.2.0",
    "@arki/failure": "0.3.0",
    "@arki/log": "0.4.0",
    "@arki/schema": "0.3.0",
    "@keyv/redis": "5.1.6",
    "@opentelemetry/api": "^1.9.1",
    "@t3-oss/env-core": "^0.13.11",
    "ioredis": "^5.11.1",
    "keyv": "^5.6.0",
    "rate-limiter-flexible": "^11.2.1"
  },
  "peerDependencies": {
    "@arki/dot": "^0.10.0",
    "@arki/http": "^0.4.1"
  },
  "peerDependenciesMeta": {
    "@arki/dot": {
      "optional": true
    },
    "@arki/http": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
